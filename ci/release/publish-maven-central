#!/usr/bin/env bash
#
# Publishes the kept release artifacts to Maven Central unchanged, through the Central Portal API.
#
# Usage: publish-maven-central ARTIFACTS_DIR
#
# ARTIFACTS_DIR is what `ci/release/build-artifacts` kept. Every file is checked against the kept
# manifest, signed with a detached ASCII-armoured signature, bundled and uploaded as one deployment,
# which is then followed until Central reports it PUBLISHED. Gradle is not involved: its publish
# tasks rebuild, and publication ships only what the release pull request built.
#
# A rerun after a completed deployment uploads nothing: it confirms that Maven Central serves the
# kept files and succeeds, so finalization can proceed. A partly published version fails.
#
# Environment: RELEASE_VERSION, MAVEN_CENTRAL_USERNAME and MAVEN_CENTRAL_PASSWORD (a Central Portal
# user token), SIGNING_KEY (an ASCII-armoured private key) and SIGNING_KEY_PASSWORD.
set -euo pipefail

artifacts="$(cd "${1:?Usage: publish-maven-central ARTIFACTS_DIR}" && pwd)"
central="https://central.sonatype.com/api/v1/publisher"
mirror="https://repo1.maven.org/maven2"

missing=()
for name in RELEASE_VERSION MAVEN_CENTRAL_USERNAME MAVEN_CENTRAL_PASSWORD SIGNING_KEY SIGNING_KEY_PASSWORD; do
  if [ -z "${!name:-}" ]; then
    missing+=("$name")
  fi
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "Missing ${missing[*]}. Maven Central credentials and the signing key are secrets of the release environment." >&2
  exit 1
fi

echo "==> Checking the kept artifacts against their manifest"
kept_version="$(tr -d '[:space:]' < "$artifacts/VERSION")"
if [ "$kept_version" != "$RELEASE_VERSION" ]; then
  echo "The kept artifacts are $kept_version, not $RELEASE_VERSION." >&2
  exit 1
fi
(cd "$artifacts" && shasum -a 256 --check --quiet SHA256SUMS)
listed="$(wc -l < "$artifacts/SHA256SUMS" | tr -d ' ')"
present="$(cd "$artifacts" && find maven -type f | wc -l | tr -d ' ')"
if [ "$listed" != "$present" ]; then
  echo "The manifest lists $listed files, but $present are present." >&2
  exit 1
fi

auth="Authorization: Bearer $(printf '%s:%s' "$MAVEN_CENTRAL_USERNAME" "$MAVEN_CENTRAL_PASSWORD" | base64 | tr -d '\n')"

# Every staged component, as `artifact` names under the group directory.
group_path="dev/voir/areca"
namespace="dev.voir.areca"
components=()
while IFS= read -r component; do
  components+=("$component")
done < <(find "$artifacts/maven/$group_path" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort)

echo "==> Checking what Maven Central already has of $RELEASE_VERSION"
published=0
for component in "${components[@]}"; do
  state="$(curl --silent --show-error --fail-with-body --header "$auth" \
    "$central/published?namespace=$namespace&name=$component&version=$RELEASE_VERSION" | jq -r '.published')"
  if [ "$state" = "true" ]; then
    published=$((published + 1))
  fi
done

if [ "$published" -eq "${#components[@]}" ]; then
  echo "Every component of $RELEASE_VERSION is already published; confirming it is this release."
  mismatches=0
  while IFS= read -r file; do
    path="${file#maven/}"
    remote="$(curl --silent --fail "$mirror/$path.sha1" | tr -d '[:space:]' || true)"
    kept="$(tr -d '[:space:]' < "$artifacts/$file.sha1")"
    if [ "$remote" != "$kept" ]; then
      echo "  $path: Maven Central serves '${remote:-nothing yet}', the kept file is $kept." >&2
      mismatches=$((mismatches + 1))
    fi
  done < <(cd "$artifacts" && find maven -type f ! -name '*.md5' ! -name '*.sha1' ! -name '*.sha256' ! -name '*.sha512' | LC_ALL=C sort)
  if [ "$mismatches" -gt 0 ]; then
    echo "$mismatches files differ or are not mirrored yet. If the version was published moments ago, re-run once repo1 serves it." >&2
    exit 1
  fi
  echo "Maven Central serves exactly the kept files."
  exit 0
fi
if [ "$published" -gt 0 ]; then
  echo "$published of ${#components[@]} components of $RELEASE_VERSION are already published." >&2
  echo "A version is never overwritten; inspect the deployments at https://central.sonatype.com/publishing/deployments." >&2
  exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

echo "==> Signing every file"
export GNUPGHOME="$work/gnupg"
mkdir -m 700 "$GNUPGHOME"
printf '%s' "$SIGNING_KEY" | gpg --batch --quiet --import
passphrase="$GNUPGHOME/passphrase"
(umask 077 && printf '%s' "$SIGNING_KEY_PASSWORD" > "$passphrase")

cp -R "$artifacts/maven" "$work/bundle"
signed=0
while IFS= read -r file; do
  gpg --batch --quiet --yes --pinentry-mode loopback --passphrase-file "$passphrase" \
    --armor --detach-sign --output "$file.asc" "$file"
  signed=$((signed + 1))
done < <(find "$work/bundle" -type f ! -name '*.md5' ! -name '*.sha1' ! -name '*.sha256' ! -name '*.sha512')
echo "Signed $signed files."

(cd "$work/bundle" && zip --quiet --recurse-paths "$work/bundle.zip" .)

echo "==> Uploading the bundle"
deployment="$(curl --silent --show-error --fail-with-body --header "$auth" \
  --form "bundle=@$work/bundle.zip" \
  "$central/upload?name=areca-$RELEASE_VERSION&publishingType=AUTOMATIC")"
echo "Deployment $deployment created."

echo "==> Waiting for Maven Central to publish deployment $deployment"
deadline=$((SECONDS + 75 * 60))
while :; do
  status="$(curl --silent --show-error --fail-with-body --request POST --header "$auth" \
    "$central/status?id=$deployment")"
  state="$(jq -r '.deploymentState' <<< "$status")"
  case "$state" in
    PUBLISHED)
      echo "Deployment $deployment is published."
      exit 0
      ;;
    FAILED)
      echo "Maven Central rejected deployment $deployment:" >&2
      jq '.errors' <<< "$status" >&2
      exit 1
      ;;
  esac
  if [ "$SECONDS" -ge "$deadline" ]; then
    echo "Deployment $deployment is still $state. Follow it at https://central.sonatype.com/publishing/deployments, then re-run this job." >&2
    exit 1
  fi
  echo "  $state"
  sleep 30
done
