#!/usr/bin/env bash
#
# Raises the `version` of `.claude-plugin/plugin.json`, the `areca` Claude Code plugin, to the next
# release of the given kind: from 1.2.3, patch, minor and major give 1.2.4, 1.3.0 and 2.0.0.
#
# The plugin version is the skills' own version, not the library's. A library release raises it by
# the same kind as `VERSION` (`ci/release/prepare-version`); a skills release raises it alone
# (`ci/skills-release/prepare-version`).
#
# Usage: bump-plugin-version patch|minor|major
#
# Prints the new version on standard output, for the caller to record. Fails before changing
# anything when the kind or the manifest's version is invalid.
set -euo pipefail

cd "$(dirname "$0")/../.."

kind="${1:-}"
manifest=".claude-plugin/plugin.json"
core='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'

current="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' "$manifest")"
if [[ ! "$current" =~ ^$core$ ]]; then
  echo "$manifest states version '$current', which is not MAJOR.MINOR.PATCH." >&2
  exit 1
fi
major="${BASH_REMATCH[1]}"
minor="${BASH_REMATCH[2]}"
patch="${BASH_REMATCH[3]}"

case "$kind" in
  patch) version="$major.$minor.$((patch + 1))" ;;
  minor) version="$major.$((minor + 1)).0" ;;
  major) version="$((major + 1)).0.0" ;;
  *)
    echo "The plugin bump must be patch, minor or major, not '$kind'." >&2
    exit 1
    ;;
esac

# A JSON edit, not a text substitution: only the `version` value changes, and the manifest keeps its
# key order and two-space layout.
python3 - "$version" <<'PYTHON'
import json
import pathlib
import sys

manifest = pathlib.Path(".claude-plugin/plugin.json")
plugin = json.loads(manifest.read_text())
plugin["version"] = sys.argv[1]
manifest.write_text(json.dumps(plugin, indent=2, ensure_ascii=False) + "\n")
PYTHON
echo "Raising the plugin version to $version (was $current, $kind)." >&2
echo "$version"
